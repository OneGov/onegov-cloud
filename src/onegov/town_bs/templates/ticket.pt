<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:b metal:fill-slot="title">
        <tal:b i18n:translate>Ticket</tal:b>
    </tal:b>
    <tal:b metal:fill-slot="lead">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content" tal:define="is_manager request.is_manager_for_model(ticket)">

        <tal:b metal:use-macro="layout.macros.page_content" tal:define="show_side_panel True;">
            <tal:b metal:fill-slot="before-panels">

                <tal:b metal:use-macro="layout.macros['side_panel_card']">
                    <tal:b metal:fill-slot="panel-title">
                        <tal:b i18n:translate>Submitter</tal:b>
                    </tal:b>
                    <tal:b metal:fill-slot="panel-content">
                        <div class="ticket-submitter ${ticket.muted and 'ticket-submitter-muted' or 'ticket-submitter-unmuted'}">
                            <div class="ticket-submitter-meta ticket-submitter-email mb-sm" tal:attributes="data-edit edit_email_url|nothing">
                                <i class="far fa-fw fa-envelope"></i>
                                <a href="mailto:${submitter}">${submitter}</a>
                                <i tal:condition="edit_email_url" id="edit-ticket-email" class="fas fw fa-edit text-primary" aria-hidden="true"></i>
                            </div>

                            <div tal:condition="submitter_name" class="ticket-submitter-meta mb-sm">
                                <i class="fas fa-fw fa-user" aria-hidden="true"></i>
                                <span>${submitter_name}</span>
                            </div>

                            <div tal:condition="submitter_address" class="ticket-submitter-meta mb-sm">
                                <i class="fas fa-fw fa-home" aria-hidden="true"></i>
                                <span>${submitter_address}</span>
                            </div>

                            <div tal:condition="submitter_phone" class="ticket-submitter-meta mb-sm">
                                <i class="fas fa-fw fa-phone" aria-hidden="true"></i>
                                <span tal:content="layout.linkify(submitter_phone)"></span>
                            </div>

                            <div tal:condition="not:ticket.muted" class="ticket-submitter-notification-status mb-sm">
                                <i class="fa fa-fw fa-check" aria-hidden="true"></i>
                                <span i18n:translate>
                                    Ticket updates by e-mail
                                </span>

                                <a tal:condition="is_manager" class="btn btn-light btn-sm mb-sm" href="${request.link(ticket, 'mute')}">
                                    <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                    <span i18n:translate>Disable E-Mails</span>
                                </a>
                            </div>

                            <div tal:condition="ticket.muted" class="ticket-submitter-notification-status mb-sm">
                                <i class="fa fa-fw fa-times" aria-hidden="true"></i>

                                <span i18n:translate class="prevent-text-overflow">
                                    No ticket updates via e-mail. An e-mail is still sent when a ticket is assigned.
                                </span>

                                <tal:b condition="not event_source">
                                    <a tal:condition="is_manager" class="btn btn-light btn-sm" href="${request.link(ticket, 'unmute')}">
                                        <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                        <span i18n:translate>Enable E-Mails</span>
                                    </a>
                                </tal:b>

                                <tal:b condition="event_source">
                                    <a tal:condition="is_manager" class="btn btn-light btn-sm confirm disabled"
                                    data-confirm="E-Mails can not be sent for tickets of imported events"
                                        data-confirm-no="Cancel"
                                    i18n:attributes="data-confirm;data-confirm-no"
                                    >
                                        <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                        <span i18n:translate>Enable E-Mails</span>

                                    </a>
                                </tal:b>
                            </div>

                            <tal:b condition="not event_source and ticket.state != 'closed'">
                                <a tal:condition="is_manager" class="btn btn-primary btn-sm mb-sm" href="${request.link(ticket, 'message-to-submitter')}">
                                    <i class="far fa-fw fa-comment" aria-hidden="true"></i>
                                    <span i18n:translate>Send Message</span>
                                </a>
                            </tal:b>

                            <tal:b condition="not event_source and ticket.state == 'closed'">
                                <a tal:condition="is_manager" class="disabled confirm btn btn-primary btn-sm mb-sm"
                                    data-confirm="Messages cannot be sent when the ticket is closed"
                                    data-confirm-extra="Please reopen the ticket to send a message"
                                    data-confirm-no="Cancel"
                                    i18n:attributes="data-confirm;data-confirm-extra;data-confirm-no">

                                    <i class="far fa-fw fa-comment" aria-hidden="true"></i>
                                    <span i18n:translate>Send Message</span>
                                </a>
                            </tal:b>

                            <tal:b condition="event_source">
                                <a tal:condition="is_manager" class="disabled confirm btn btn-sm"
                                    data-confirm="Messages cannot be sent for imported events"
                                    data-confirm-no="Cancel"
                                    i18n:attributes="data-confirm;data-confirm-no">

                                    <i class="far fa-fw fa-comment" aria-hidden="true"></i>
                                    <span i18n:translate>Send Message</span>
                                </a>
                            </tal:b>

                            <ul class="counts" tal:condition="counts and (counts.notes or counts.internal or counts.external)">
                                <li tal:condition="counts.external" class="counts-external">
                                    <a href="#timeline" i18n:translate>
                                        <span class="counts-value" i18n:name="count">${counts.external}</span> received
                                    </a>
                                </li>
                                <li tal:condition="counts.internal" class="counts-internal">
                                    <a href="#timeline" i18n:translate>
                                        <span class="counts-value" i18n:name="count">${counts.internal}</span> sent
                                    </a>
                                </li>
                                <li tal:condition="counts.notes" class="counts-note">
                                    <a href="#timeline" i18n:translate tal:condition="counts.notes == 1">
                                        <span class="counts-value" i18n:name="count">${counts.notes}</span> note
                                    </a>
                                    <a href="#timeline" i18n:translate tal:condition="counts.notes > 1">
                                        <span class="counts-value" i18n:name="count">${counts.notes}</span> notes
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </tal:b>
                </tal:b>

                <tal:b metal:use-macro="layout.macros['side_panel_card']" tal:define="payment handler.payment; invoice ticket.invoice" tal:condition="invoice or payment">
                    <tal:b metal:fill-slot="panel-title">
                        <tal:b i18n:translate>Payment</tal:b>
                    </tal:b>
                    <tal:b metal:fill-slot="panel-content">
                        <dl>
                            <dt i18n:translate>Amount</dt>
                            <dd class="ticket-payment-amount">
                                <tal:b tal:condition="payment">
                                    <span><tal:b metal:use-macro="layout.macros['price']" tal:define="price payment; show_fee True;" /></span>
                                    <a tal:condition="edit_amount_url" href="${edit_amount_url}" class="fas fw fa-edit"></a>
                                </tal:b>
                                <tal:b tal:condition="not:payment">
                                    <span i18n:translate>Free of charge</span>
                                </tal:b>
                            </dd>

                            <dt i18n:translate>State</dt>
                            <dd class="ticket-payment-status">
                                <tal:b tal:condition="payment" metal:use-macro="layout.macros['payment_status']" />
                                <div i18n:translate tal:condition="not:payment" class="payment-state payment-state-paid">
                                    Closed
                                </div>
                            </dd>

                            <tal:b tal:condition="payment">
                                <dt i18n:translate>Source</dt>
                                <dd class="ticket-payment-source">
                                    <tal:b metal:use-macro="layout.macros['payment_source']" />
                                </dd>
                            </tal:b>
                        </dl>

                        <tal:b tal:condition="payment_button" tal:replace="payment_button(layout)" />

                        <a tal:condition="is_manager and invoice" href="${request.link(ticket, 'invoice')}" class="btn btn-primary btn-sm mt-sm view-invoice" i18n:translate>View Invoice</a>
                    </tal:b>
                </tal:b>

                <tal:b metal:use-macro="layout.macros['side_panel_card']">
                    <tal:b metal:fill-slot="panel-title">
                        <tal:b i18n:translate>Ticket</tal:b>
                    </tal:b>

                    <tal:b metal:fill-slot="panel-content">
                        <dl>
                            <dt i18n:translate>State</dt>
                            <dd class="ticket-state">
                                <tal:b metal:use-macro="layout.macros['ticket_status']" />
                            </dd>

                            <dt i18n:translate>Group</dt>
                            <dd class="ticket-group" tal:define="group handler.group|ticket.group">
                                <a tal:condition="exists:handler/resource" href="${request.link(handler.resource)}">${group}</a>
                                <span tal:condition="not:exists:handler/resource">${group}</span>
                            </dd>

                            <tal:b tal:condition="ticket.handler_code == 'RSV' and request.app.org.ticket_tags">
                                <dt><span i18n:translate>Tag</span> <a href="${request.link(ticket, 'change-tag')}" class="ticket-change-tag" title="Change tag" i18n:attributes="title" tal:condition="is_manager and ticket.state == 'pending'"></a></dt>
                                <dd class="ticket-tag">
                                    <tal:b tal:condition="ticket.tag">${ticket.tag}</tal:b>
                                    <tal:b tal:condition="not:ticket.tag" i18n:translate>Without</tal:b>
                                </dd>
                            </tal:b>

                            <tal:b tal:condition="ticket.user_id">
                                <dt i18n:translate>Owner</dt>
                                <dd class="ticket-owner">
                                    <a href="mailto:${ticket.user.username}">${ticket.user.username}</a>
                                </dd>
                            </tal:b>

                            <dt i18n:translate>Created</dt>
                            <dd class="ticket-date" tal:define="created layout.to_timezone(ticket.created, layout.timezone)">
                                ${layout.format_date(created, 'weekday_long')}, ${layout.format_date(created, 'datetime')}
                            </dd>

                            <tal:b tal:condition="ticket.reaction_time">
                                <dt i18n:translate>Reaction Time</dt>
                                <dd class="ticket-date">
                                    ${layout.format_seconds(ticket.reaction_time)}
                                </dd>
                            </tal:b>

                            <tal:b tal:condition="ticket.process_time">
                                <dt i18n:translate>Process Time</dt>
                                <dd class="ticket-date">
                                    ${layout.format_seconds(ticket.process_time)}
                                </dd>
                            </tal:b>
                        </dl>
                    </tal:b>
                </tal:b>


                <tal:b metal:use-macro="layout.macros['side_panel_card']" tal:condition="related_tickets">
                    <tal:b metal:fill-slot="panel-title">
                        <tal:b i18n:translate>Related Tickets</tal:b>
                        <tal:b tal:condition="not all(t.muted for t in related_tickets)" tal:define="event_source all(t.handler.data.get('source') for t in related_tickets)">
                            <a tal:condition="is_manager" href="${request.link(ticket, 'mute-related')}" class="mute" title="Disable E-Mails for all related tickets" i18n:attributes="title">
                                <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                            </a>
                        </tal:b>
                        <tal:b tal:condition="all(t.muted for t in related_tickets)">
                            <tal:b tal:condition="not event_source">
                                <a tal:condition="is_manager" href="${request.link(ticket, 'unmute-related')}" class="unmute" title="Enable E-Mails for all related tickets" i18n:attributes="title">
                                    <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                    <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                </a>
                            </tal:b>
                            <tal:b tal:condition="event_source">
                                <a tal:condition="is_manager" class="unmute confirm disabled" title="E-Mails can not be sent for tickets of imported events" data-confirm="E-Mails can not be sent for tickets of imported events" data-confirm-no="Cancel" i18n:attributes="title;data-confirm;data-confirm-no">
                                    <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                    <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                </a>
                            </tal:b>
                        </tal:b>
                    </tal:b>
                    <tal:b metal:fill-slot="panel-content">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex flex-wrap align-items-center py-sm" tal:repeat="ticket related_tickets">
                                <a class="fw-bold text-decoration-none me-md" href="${request.link(ticket)}">
                                    <span class="ticket-number fs-xs" title="${ticket.number}: ${ticket.reference_group(request)}">${ticket.number}</span>
                                </a>
                                <div class="me-md">
                                    <tal:b metal:use-macro="layout.macros['ticket_status']" />
                                </div>
                                <tal:b tal:condition="not:ticket.muted">
                                    <a tal:condition="is_manager" href="${request.return_here(request.link(ticket, 'mute'))}" class="mute text-decoration-none" title="Disable E-Mails" i18n:attributes="title">
                                        <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                        <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                    </a>
                                </tal:b>
                                <tal:b tal:condition="ticket.muted" tal:define="event_source ticket.handler.data.get('source')">
                                    <tal:b condition="not event_source">
                                        <a tal:condition="is_manager" href="${request.return_here(request.link(ticket, 'unmute'))}" class="unmute text-decoration-none" title="Enable E-Mails" i18n:attributes="title">
                                            <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                            <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                        </a>
                                    </tal:b>
                                    <tal:b condition="event_source">
                                        <a tal:condition="is_manager" class="unmute confirm disabled" title="E-Mails can not be sent for tickets of imported events" data-confirm="E-Mails can not be sent for tickets of imported events" data-confirm-no="Cancel" i18n:attributes="title;data-confirm;data-confirm-no">
                                            <i class="fa fa-fw fa-microphone" aria-hidden="true"></i>
                                            <i class="fa fa-fw fa-microphone-slash" aria-hidden="true"></i>
                                        </a>
                                    </tal:b>
                                </tal:b>
                            </li>
                        </ul>
                    </tal:b>
                </tal:b>

            </tal:b>

            <tal:b metal:fill-slot="main-content">
                    <div tal:condition="deleted" class="callout warning" i18n:translate>
                        The record behind this ticket was removed. The following information
                        is a snapshot kept for future reference.
                    </div>
                    <div class="ticket-cancellation-request" tal:condition="handler.data.get('cancellation_requested', False)">
                        <div class="callout warning" i18n:translate>
                            A cancellation has been requested for this reservation.
                        </div>
                        <tal:b
                            tal:define="
                                cancellation_ids handler.data.get('cancellation_reservation_ids');
                                reservations [r for r in handler.reservations if r.id in set(cancellation_ids)] if cancellation_ids else handler.reservations;
                                get_links handler.get_cancellation_links if is_manager and ticket.state == 'pending' else None;
                                get_occupancy_url handler.get_occupancy_url
                            "
                            metal:use-macro="layout.macros['reservations']">
                        </tal:b>
                        <hr>
                    </div>
                    <div class="ticket-summary mb-xl" id="summary">
                        <tal:b replace="summary" />
                    </div>

                    <div class="ticket-timeline" id="timeline">
                        <h2 i18n:translate>Timeline</h2>
                        <div class="timeline" data-feed-data="${feed_data}" data-feed='static'></div>
                        <p class="timeline-no-messages" i18n:translate style="display: none;">
                            No activities yet.
                        </p>
                    </div>
            </tal:b>

        </tal:b>
    </tal:b>
</div>
