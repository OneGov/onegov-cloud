<div metal:use-macro="layout.base" i18n:domain="onegov.town_bs">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <p tal:condition="not:imagesets" i18n:translate="">No photo albums defined yet.</p>

        <div tal:condition="imagesets" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-lg">
            <div class="col" tal:repeat="imageset imagesets">
                <a class="d-block h-100 text-decoration-none" tal:attributes="href request.link(imageset)">
                    <div class="card border-hover h-100">
                        <div class="image-card-grid row row-cols-2 g-xs">
                            <tal:b tal:repeat="image imageset.ordered_files">
                                <tal:b tal:define="size getattr(image.reference, 'size', None)">
                                    <div tal:condition="size and repeat.image.number <= 4" class="col">
                                        <div class="ratio ratio-4x3">
                                            <img class="object-fit-cover rounded-2"
                                                src="${request.link(image)}"
                                                alt="${image.note}"
                                                tal:attributes="width size and size[0];
                                                                height size and size[1]" />
                                        </div>
                                    </div>
                                </tal:b>
                            </tal:b>
                        </div>
                        <div class="card-body">
                            <h3>${imageset.title}</h3>
                            <metal:hint use-macro="layout.macros['access_hint']" tal:define="item imageset" />
                            <div class="imageset-date small text-body-secondary mb-sm">${layout.format_date(imageset.created, 'date')}</div>
                            <div class="list-lead card-text">${imageset.meta.get('lead')}</div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </tal:b>
</div>