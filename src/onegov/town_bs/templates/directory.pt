<div metal:use-macro="layout.base" i18n:domain="onegov.town_bs">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="lead">
        <span id="directory-lead" tal:condition="directory.lead" tal:content="layout.linkify(directory.lead)" />
    </tal:b>

    <tal:b metal:fill-slot="content">

        <tal:b metal:use-macro="layout.macros.page_content" tal:define="show_side_panel True;">
            <tal:b metal:fill-slot="before-panels">

                <tal:b define="enable_update_notifications directory.enable_update_notifications|False">
                    <div class="side-panel" tal:condition="directory.enable_submissions or enable_update_notifications">
                        <h3 i18n:translate>Actions</h3>
                        <div class="side-panel-with-bg">
                            <ul class="more-list">
                                <li class="icon-item" tal:condition="directory.enable_update_notifications|False">
                                    <a class="list-link multi-line" href="${new_recipient_link}">
                                        <i class="fa fa-bell"></i>
                                        <span class="list-title" i18n:translate>Get notifications on new entries</span>
                                    </a>
                                </li>
                                <li class="icon-item" tal:condition="directory.enable_submissions">
                                    <a class="list-link" href="${submit}">
                                        <i class="fa fa-folder-plus"></i>
                                        <span class="list-title" i18n:translate>Propose a new entry</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </tal:b>

            </tal:b>

            <tal:b metal:fill-slot="main-content">

                <div tal:condition="directory.enable_map == 'everywhere'">
                    <div class="geojson-map directories-map rounded-3"
                        data-geojson="${geojson}"
                        data-lat="${layout.default_map_view.lat}"
                        data-lon="${layout.default_map_view.lon}"
                        data-zoom="${layout.default_map_view.zoom}"
                        data-map-height="450px"
                    ></div>
                </div>

                <div class="mt-lg">
                    <div metal:use-macro="layout.macros['offcanvas_filters']">
                        <tal:b metal:fill-slot="filters-body">
                            <!-- Search Widget -->
                            <div class="row" tal:condition="search_widget">
                                <div class="col-md-12">
                                    <tal:b replace="search_widget.html(layout)" />
                                </div>
                            </div>

                            <div class="side-panel" tal:condition="layout.publication_filters">
                                <h3 i18n:translate>Publication</h3>
                                <div class="side-panel-with-bg">
                                    <div class="filter-panel">
                                        <ul class="tags">
                                            <li tal:repeat="link layout.publication_links">
                                                <span class="blank-label click-through rounded ${' '.join(link.attrs['class'])}">
                                                    ${link(layout)}
                                                </span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="filter-panel side-panel" tal:condition="filters">
                                <div tal:repeat="filter filters" class="filter-periods">
                                    <h3 class="filter-title">${filter.title}</h3>
                                    <div metal:use-macro="layout.macros['tags']" tal:define="tags filter.tags" />
                                </div>
                            </div>
                        </tal:b>
                    </div>
                </div>

                <tal:b tal:condition="not:entries" tal:switch="not:directory.configuration.empty_notice">
                    <p tal:case="True" i18n:translate="">No entries found.</p>
                    <p tal:case="False">${directory.configuration.empty_notice}</p>
                </tal:b>

                <div class="further-information" tal:define="text directory.text|nothing; title directory.content.get('title_further_information'); above directory.content.get('position')=='above'" tal:condition="text and above">
                    <h2 tal:condition="title">${title}</h2>
                    <h2 tal:condition="not title" i18n:translate="">Further Information</h2>
                    <tal:b content="text"/>
                </div>

                <div id="directory-accordion" tal:condition="directory.layout == 'accordion'" class="more-list page-links accordion">
                    <!-- displaying in accordion mode -->
                    <div tal:repeat="entry entries" class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#directory-entry-${repeat.entry.index}" aria-expanded="false" aria-controls="directory-entry-${repeat.entry.index}">
                                <span class="h5">${entry.title}</span>
                            </button>
                        </h2>
                        <div id="directory-entry-${repeat.entry.index}" class="accordion-collapse collapse" data-bs-parent="#directory-accordion">
                            <div class="accordion-body">
                                <ul tal:repeat="field directory.fields" tal:define="content_labels entry.content_labels; hidden_labels entry.hidden_label_fields" class="list-unstyled">
                                    <tal:block tal:condition="field.id in content_labels">
                                        <li tal:condition="field.type == 'textarea'" tal:define="key field.id; human_id field.human_id; value entry.values[field.id]" style="white-space: pre-wrap;">
                                            <tal:block tal:condition="key in hidden_labels" tal:content="value" />
                                            <tal:block tal:condition="not:key in hidden_labels" tal:content="Markup('&lt;strong&gt;{}&lt;/strong&gt;: &lt;br&gt;{}').format(human_id, value)" />
                                        </li>
                                        <li tal:condition="field.type != 'textarea'" tal:define="key field.id; human_id field.human_id; value entry.values[field.id]">
                                            <tal:block tal:condition="key in hidden_labels" tal:content="value" />
                                            <tal:block tal:condition="not:key in hidden_labels" tal:content="Markup('&lt;strong&gt;{}&lt;/strong&gt;: {}').format(human_id, value)" />
                                        </li>
                                    </tal:block>
                                </ul>
                                <ul class="list-unstyled">
                                    <li>
                                        <a tal:condition="request.is_manager" class="edit-link" tal:attributes="href request.link(entry)">
                                            <i class="far fa-edit"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- displaying in default mode -->
                <ul class="styled-list directory-list ${'with-thumbnails' if show_thumbnails else ''} subpage-cards ${'row gx-md' if overview_two_columns else ''}" tal:condition="directory.layout == 'default'">
                    <li class="col-12 ${'col-md-6' if overview_two_columns else ''}" tal:repeat="entry entries">
                        <a class="styled-list-link ${'card' if overview_two_columns else 'row gx-md'}" tal:attributes="href request.link(entry)">
                            <div class="row">
                                <div class="${'' if overview_two_columns else 'col-3'}" tal:condition="show_thumbnails" >
                                    <tal:b define="thumbnail thumbnail_link(entry)" condition="thumbnail">
                                        <div tal:condition="overview_two_columns" class="card-image w-100" style="padding-bottom: 55%; background-image: url(${thumbnail}); background-size: cover;"></div>
                                        <img tal:condition="not overview_two_columns" data-src="${thumbnail}" class="lazyload img-fluid max-height-lg rounded-0" data-no-alt align="top" alt="" />
                                    </tal:b>
                                </div>

                                <div class="${'card-body' if overview_two_columns else ('col-9' if show_thumbnails else 'col')}">
                                    <span class="styled-list-title"><tal:b tal:condition="entry.number">${entry.number}. </tal:b>${entry.title}</span>
                                    <metal:hint use-macro="layout.macros['access-hint']" tal:define="item entry" />

                                <tal:b define="custom_lead search_widget.lead(layout, entry)|nothing">
                                    <p class="styled-list-lead">
                                        <tal:b condition="custom_lead" replace="custom_lead" />
                                        <tal:b condition="not:custom_lead" replace="escape(entry.lead).replace('\\n', Markup('<br>'))" />
                                    </p>
                                </tal:b>
                                </div>
                            </div>
                        </a>
                    </li>
                </ul>

                <div class="further-information" tal:define="text directory.text|nothing; title directory.content.get('title_further_information'); below directory.content.get('position')!='above'" tal:condition="text and below">
                    <h2 tal:condition="title">${title}</h2>
                    <h2 tal:condition="not title" i18n:translate="">Further Information</h2>
                    <tal:b content="text"/>
                </div>
            </tal:b>
        </tal:b>

    </tal:b>
</div>