<div metal:use-macro="layout.base" i18n:domain="onegov.org">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <div class="audit-entry">
        <div class="audit-entry-summary d-flex align-items-center gap-lg ">
        <span class="audit-operation audit-${entry.operation} badge ${ {'insert': 'badge-primary', 'update': 'badge-info', 'delete': 'badge-danger'}.get(entry.operation, 'badge-light') } flex-shrink-0">
            ${operation}
        </span>
            <div class="audit-entry-heading d-flex flex-column gap-xs min-w-0">
                <strong>
                    <a tal:condition="current_page"
                        href="${request.link(current_page)}">
                        ${entry.snapshot.get(
                            'title', entry.target_table
                        )}
                        <i class="fa fa-external-link-alt ms-xs"
                            aria-hidden="true"></i>
                    </a>
                    <tal:b tal:condition="not:current_page">
                        ${entry.snapshot.get(
                            'title', entry.target_table
                        )}
                    </tal:b>
                </strong>
                <small class="audit-entry-details d-flex flex-wrap align-items-center gap-lg">
                    <span class=" text-body-tertiary">
                        <i class="far fa-clock me-xs"
                            aria-hidden="true"></i>
                        ${layout.format_date(entry.created, 'datetime')}
                    </span>
                    <span class="audit-entry-user text-body-tertiary">
                        <i class="far fa-user me-xs"
                            aria-hidden="true"></i>
                        ${entry.username}
                    </span>
                </small>
            </div>
        </div>

        <div class="card my-md">
            <section class="audit-diff-panel card-body" tal:condition="diff">
                <div class="audit-snapshot-heading">
                    <h2 class="mb-md" i18n:translate>Changes</h2>
                </div>
                <div class="audit-diff">${diff}</div>
            </section>
        </div>

            <div class="accordion" id="audit-snapshots">
                <div class="audit-snapshot-panel accordion-item"
                    tal:condition="previous_snapshot">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#audit-previous-snapshot-panel"
                            aria-expanded="false"
                            aria-controls="audit-previous-snapshot-panel"
                            i18n:translate>Before update</button>
                    </h2>
                    <div id="audit-previous-snapshot-panel"
                        class="accordion-collapse collapse"
                        data-bs-parent="#audit-snapshots">
                        <div class="accordion-body p-md">
                            <div class="audit-snapshot-heading d-flex justify-content-between">
                                <h2 i18n:translate>Before update</h2>
                                <button class="audit-copy btn btn-sm btn-ghost"
                                    type="button"
                                    data-clipboard-action="copy"
                                    data-clipboard-target="#audit-previous-snapshot"
                                    title="Copy JSON"
                                    aria-label="Copy JSON"
                                    data-copy-success-label="Copied to Clipboard!"
                                    i18n:attributes="title;aria-label;data-copy-success-label">
                                    <i class="far fa-copy" aria-hidden="true"></i>
                                </button>
                            </div>
                            <pre id="audit-previous-snapshot"
                                class="audit-snapshot mb-0">${previous_snapshot}</pre>
                        </div>
                    </div>
                </div>

                <div class="audit-snapshot-panel accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#audit-snapshot-panel"
                            aria-expanded="false"
                            aria-controls="audit-snapshot-panel"
                            i18n:translate>JSON Snapshot</button>
                    </h2>
                    <div id="audit-snapshot-panel"
                        class="accordion-collapse collapse"
                        data-bs-parent="#audit-snapshots">
                        <div class="accordion-body p-md">
                            <div class="audit-snapshot-heading d-flex justify-content-between">
                                <h2 tal:condition="previous_snapshot"
                                    i18n:translate>After update</h2>
                                <h2 tal:condition="not:previous_snapshot"
                                    i18n:translate>JSON Snapshot</h2>
                                <button class="audit-copy btn btn-sm btn-ghost"
                                    type="button"
                                    data-clipboard-action="copy"
                                    data-clipboard-target="#audit-snapshot"
                                    title="Copy JSON"
                                    aria-label="Copy JSON"
                                    data-copy-success-label="Copied to Clipboard!"
                                    i18n:attributes="title;aria-label;data-copy-success-label">
                                    <i class="far fa-copy" aria-hidden="true"></i>
                                </button>
                            </div>
                            <pre id="audit-snapshot"
                                class="audit-snapshot mb-0">${snapshot}</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </tal:b>
</div>