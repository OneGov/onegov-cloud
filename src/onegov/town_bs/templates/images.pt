<div metal:use-macro="layout.base" i18n:domain="onegov.town_bs">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <tal:b metal:use-macro="layout.macros.page_content">
            <tal:b metal:fill-slot="main-content">

                <tal:block metal:use-macro="layout.macros['modal']" tal:define="modal_id 'delete-image-modal'; show_close True; show_confirm True; confirm_icon 'trash-2'; confirm_attrs {'data-confirm-yes': ''}">
                    <tal:block metal:fill-slot="modal_title">
                        <tal:b i18n:translate="">Delete Image</tal:b>
                    </tal:block>
                    <tal:block metal:fill-slot="confirm_label">
                        <tal:b i18n:translate="">Delete Image</tal:b>
                    </tal:block>
                </tal:block>
                <div class="row mb-xl">
                    <div class="col-12" tal:define="upload_url layout.image_upload_url">
                        <h2 i18n:translate="">Upload</h2>

                        <tal:b metal:use-macro="layout.macros.upload">
                            <tal:b metal:fill-slot="upload-filelist">
                                <div class="upload-filelist-header" style="display: none;">
                                    <h2 i18n:translate>Just Uploaded</h2>
                                    <div class="alert alert-info">
                                        <p class="mb-0" i18n:translate="">
                                            To edit the image descriptions, click on one, enter your descrption and press return.
                                            To abort press escape.
                                        </p>
                                    </div>

                                    <div class="upload-filelist image-grid row row-cols-1 row-cols-sm-3 row-cols-lg-5 g-md align-items-start">

                                    </div>
                                </div>
                            </tal:b>
                        </tal:b>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <tal:b tal:repeat="group images">
                            <h2 i18n:translate="">${group['group']}</h2>
                            <div class="image-grid row row-cols-1 row-cols-sm-3 row-cols-lg-5 g-lg align-items-start mb-xl">
                                <tal:b repeat="image group['images']">
                                    <tal:b metal:use-macro="layout.macros.uploaded_image" define="index repeat.image.index" />
                                </tal:b>
                            </div>
                        </tal:b>
                        <tal:b condition="not:images">
                            <p i18n:translate="">No images uploaded yet</p>
                        </tal:b>
                    </div>
                </div>
            </tal:b>
        </tal:b>
    </tal:b>
</div>