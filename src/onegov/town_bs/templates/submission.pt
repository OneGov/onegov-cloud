<tal:b i18n:domain="onegov.town6">
    <div id="content">
        <tal:b tal:condition="not:completable">
                <div metal:use-macro="layout.macros['form-modal-definition']" />
        </tal:b>
        <tal:b tal:condition="completable">
            <tal:b metal:use-macro="layout.macros['form-modal']">
                <tal:b metal:fill-slot="modal-main-content">
                        <div class="alert alert-secondary" role="alert" tal:condition="model.state == 'pending'">
                                <p i18n:translate="">
                                Please review your data and press "Complete" to finalize the process.
                                If there's anything you'd like to change, click on "Edit" to return
                                to the filled-out form.
                            </p>
                        </div>
                        <div metal:use-macro="layout.macros['display_form']" />
                        <tal:b metal:use-macro="layout.macros['checkout_form']"
                            tal:define="payment_method model.payment_method; show_privacy_settings True">

                            <tal:b metal:fill-slot="after-submit">
                                <a
                                    href="${edit_link}"
                                    hx-get= "${edit_link}"
                                    hx-target="#form-modal-body"
                                    hx-select="#content > *"
                                    hx-push-url="${edit_link}"
                                    i18n:translate="">
                                    Edit
                                </a>
                            </tal:b>
                        </tal:b>
                </tal:b>
            </tal:b>
        </tal:b>
    </div>
</tal:b>
