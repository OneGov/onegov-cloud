<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:b metal:fill-slot="title">
        <tal:b i18n:translate>Check</tal:b>
    </tal:b>
    <tal:b metal:fill-slot="lead">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <tal:b metal:use-macro="layout.macros.page_content" tal:define="show_side_panel True;">
            <tal:b metal:fill-slot="before-panels">
                <div metal:use-macro="layout.macros['progress_indicator']" tal:define="steps layout.get_step_sequence()|nothing"/>
            </tal:b>
            <tal:b metal:fill-slot="main-content">
                <tal:b tal:condition="not:completable">
                    <div metal:use-macro="layout.macros['form']" />
                </tal:b>
                <tal:b tal:condition="completable">
                    <div class="alert alert-info" tal:condition="model.state == 'pending'">
                        <p i18n:translate="">
                            Please review your data and press "Complete" to finalize the process.
                            If there's anything you'd like to change, click on "Edit" to return
                            to the filled-out form.
                        </p>
                    </div>
                    <div metal:use-macro="layout.macros['display_form']" />
                </tal:b>
                <tal:b tal:condition="completable">
                    <tal:b metal:use-macro="layout.macros['checkout_form']"
                        tal:define="payment_method model.payment_method; show_privacy_settings True">

                        <tal:b metal:fill-slot="after-submit">
                            <a href="${edit_link}" i18n:translate="">Edit</a>
                        </tal:b>
                    </tal:b>
                </tal:b>
            </tal:b>
        </tal:b>
    </tal:b>
</div>
