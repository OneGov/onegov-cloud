<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <div class="org-settings">

            <div class="settings-search">
                <label for="settings-search" class="show-for-sr"
                       i18n:translate="">Search</label>
                <input id="settings-search" data-settings-search=""
                       type="search" placeholder="Search"
                       i18n:attributes="placeholder" autocomplete="off"
                       role="combobox" aria-autocomplete="list"
                       aria-controls="settings-search-results"
                       aria-expanded="false" />
                <div id="settings-search-results"
                     class="settings-search-dropdown"
                     data-settings-search-results="" role="listbox"
                     hidden="hidden">
                    <tal:s tal:repeat="setting settings_search_results">
                        <a href="${setting.link}"
                           class="settings-search-result"
                           data-settings-search-result=""
                           data-settings-result-kind="section"
                           data-settings-search-text="${setting.search_text}"
                           role="option" hidden="hidden">
                            <strong>${setting.title}</strong>
                        </a>
                        <a tal:repeat="fieldset setting.fieldsets"
                           href="${fieldset.link}"
                           class="settings-search-result"
                           data-settings-search-result=""
                           data-settings-result-kind="fieldset"
                           data-settings-search-text="${fieldset.search_text}"
                           role="option" hidden="hidden">
                            <strong>${fieldset.title}</strong>
                            <span>${setting.title}</span>
                        </a>
                        <a tal:repeat="field setting.fields"
                           href="${field.link}"
                           class="settings-search-result"
                           data-settings-search-result=""
                           data-settings-result-kind="field"
                           data-settings-search-text="${field.search_text}"
                           role="option" hidden="hidden">
                            <strong>${field.title}</strong>
                            <span>
                                ${setting.title}
                                <tal:f tal:condition="field.fieldset">
                                    · ${field.fieldset}
                                </tal:f>
                            </span>
                            <small tal:condition="field.description">
                                ${field.description}
                            </small>
                        </a>
                    </tal:s>
                    <p data-settings-no-results="" hidden="hidden"
                       aria-live="polite" i18n:translate="">
                        No entries found.
                    </p>
                </div>
            </div>

            <div tal:repeat="item settings_by_category"
                 class="settings-category">
                <h2 class="h3" tal:content="item[0]" />
                <div class="grid-x grid-margin-x small-up-1 medium-up-2
                            large-up-4">
                    <div tal:repeat="setting item[1]"
                         class="${setting.name} cell" data-settings-item="">
                        <a href="${setting.link}">
                            <div class="card">
                                <div class="card-section">
                                    <i class="fas ${setting.icon}"
                                       aria-hidden="true"></i>
                                    <span>
                                        ${setting.title}
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </tal:b>
</div>
