<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:block metal:fill-slot="title">
        ${title}
    </tal:block>
    <tal:block metal:fill-slot="content">
        <p class="information-architecture-intro" i18n:translate="">
            Explore all pages and their URL hierarchy. Use the controls to
            zoom, pan, or change the layout direction.
        </p>

        <div
            id="information-architecture-tree"
            class="information-architecture-tree"
            data-url="${data_url}"
            data-loading-label="Loading URL hierarchy…"
            data-error-label="The URL hierarchy could not be loaded."
            i18n:attributes="data-loading-label; data-error-label"
        >
            <div class="information-architecture-status" role="status">
                <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
                <span i18n:translate="">Loading URL hierarchy…</span>
            </div>
        </div>

        <noscript>
            <div class="callout warning" i18n:translate="">
                JavaScript is required to display the URL hierarchy.
            </div>
        </noscript>
    </tal:block>
</div>
