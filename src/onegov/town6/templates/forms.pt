<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="lead">
        <tal:b i18n:translate="">Nutzen Sie unsere Online-Formulare, um Ihre Anliegen bequem, einfach und unabhängig von den Öffnungszeiten digital zu erledigen.</tal:b>
    </tal:b>
    <tal:b metal:fill-slot="content">
        <tal:b metal:use-macro="layout.macros.page_content"
                 tal:define="lead None; text None; people None; coordinates None; contact layout.org.contact_html|None">
            <tal:b metal:fill-slot="after-text">
                <p tal:condition="not:forms" i18n:translate="">No forms defined yet.</p>
                <metal:b use-macro="layout.macros['accordion_grouped_by_column']" tal:condition="forms" tal:define="grouped forms; add_pagerefs request.is_logged_in" />
                <div class="modal fade ${'onload' if modal_context else ''}" id="form-modal" tabindex="-1" aria-hidden="${'false' if modal_context else 'false'}" aria-labelledby="form-modal-label">
                    <div class="modal-dialog modal-xl modal-dialog-scrollable">
                        <div class="modal-content rounded-lg">
                            <div class="modal-header">
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close" i18n:attributes="aria-label"></button>
                            </div>
                            <div class="modal-body" id="form-modal-body">
                                <tal:b condition="modal_context"
                                    define="layout modal_context['layout'];
                                                title modal_context['title'];
                                                form modal_context['form'];
                                                definition modal_context['definition'];
                                                form_width modal_context['form_width'];
                                                lead modal_context['lead'];
                                                text modal_context['text'];
                                                people modal_context['people'];
                                                files modal_context['files'];
                                                contact modal_context['contact'];
                                                coordinates modal_context['coordinates'];
                                                hints modal_context['hints'];
                                                hints_callout modal_context['hints_callout'];
                                                button_text modal_context['button_text']"
                                    metal:use-macro="layout.macros['form-modal']" />
                            </div>
                        </div>
                    </div>
                </div>
            </tal:b>
        </tal:b>
    </tal:b>
</div>
