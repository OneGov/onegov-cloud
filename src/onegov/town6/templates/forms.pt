<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="lead">
        <tal:b i18n:translate="">Nutzen Sie unsere Online-Formulare, um Ihre Anliegen bequem, einfach und unabhängig von den Öffnungszeiten digital zu erledigen.</tal:b>
    </tal:b>
    <tal:b metal:fill-slot="content">
        <tal:b metal:use-macro="layout.macros.page_content"
                 tal:define="lead None; text None; people None; coordinates None; contact layout.org.contact_html|None">
            <tal:b metal:fill-slot="after-text">
                <p tal:condition="not:forms" i18n:translate="">No forms defined yet.</p>
                <metal:b use-macro="layout.macros['accordion_grouped_by_column']" tal:condition="forms" tal:define="grouped forms; add_pagerefs request.is_logged_in" />
                <div class="modal fade" id="form-modal" tabindex="-1" aria-hidden="true" aria-labelledby="form-modal-label">
                    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
                        <div class="modal-content rounded-2">
                            <div class="modal-body p-0" id="form-modal-body">
                            </div>
                        </div>
                    </div>
                </div>
            </tal:b>
        </tal:b>
    </tal:b>
</div>
