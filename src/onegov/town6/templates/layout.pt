<!DOCTYPE html>
<html
    class="no-js"
    lang="${request.html_lang}"
    tal:attributes="layout.custom_html_attributes|{}"
    xmlns="http://www.w3.org/1999/xhtml"
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    xmlns:metal="http://xml.zope.org/namespaces/metal"
    xmlns:tal="http://xml.zope.org/namespaces/tal"
    i18n:domain="onegov.town6"
    metal:define-macro="layout">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--! use DELETE/PUT instead of POST as we target IE 11+ -->
    <meta name="intercoolerjs:use-actual-http-method" content="true" />

    <title id="page-title"><div metal:define-slot="title"></div></title>
    <!-- This site is running on the
          ___              ____               ____ _                 _
         / _ \ _ __   ___ / ___| _____   __  / ___| | ___  _   _  __| |
        | | | | '_ \ / _ \ |  _ / _ \ \ / / | |   | |/ _ \| | | |/ _` |
        | |_| | | | |  __/ |_| | (_) \ V /  | |___| | (_) | |_| | (_| |
         \___/|_| |_|\___|\____|\___/ \_/    \____|_|\___/ \__,_|\__,_|

         Have a look at the source code: https://onegov.readthedocs.org
     -->
    <link rel="stylesheet" type="text/css" href="${request.theme_link}">
    <link rel="stylesheet" type="text/css" href="${layout.font_awesome_path}">
    <tal:b tal:condition="rss_link|nothing">
        <!--! Ensures that RSS extensions auto-detect -->
        <link rel="alternate" type="application/rss+xml" title="RSS" href="${rss_link}"/>
    </tal:b>
    <style tal:condition="request.app.org.custom_css|nothing">${request.app.org.custom_css}</style>
    <tal:b metal:use-macro="layout.macros.favicon" />
    <tal:b metal:use-macro="layout.macros.open_graph_tags" />
    <script tal:condition="layout.app.sentry_dsn" src="https://browser.sentry-cdn.com/7.54.0/bundle.min.js" integrity="sha384-EmlJLN9Q0yu0/2UUCIYnEM88jpQ7xUhtNI2ZeXb/ci3cwoAoIQl350N4PQPlMbP5" crossorigin="anonymous"></script>
    <script tal:condition="layout.app.sentry_dsn" src="${layout.sentry_init_path}"></script>
    <tal:b tal:content="request.analytics_code|nothing" />
</head>

<body id="${layout.page_id}" class="${' '.join(cls for cls in layout.body_classes)} town-6 d-flex flex-column min-vh-100" data-default-marker-color="${layout.primary_color}" data-default-lat="${layout.default_map_view.lat|nothing}" data-default-lon="${layout.default_map_view.lon|nothing}" data-default-zoom="${layout.default_map_view.zoom|nothing}" tal:attributes="layout.custom_body_attributes">

    <div id="searchModal" class="modal fade" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 id="searchModalLabel" class="modal-title">Search</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="searchbox header-searchbox" action="${layout.search_url}" method="GET" data-typeahead="on" data-typeahead-source="${layout.suggestions_url}" data-typeahead-target="${layout.search_url}">
                        <div class="input-group">
                            <input id="search" class="form-control" type="search" data-typeahead-subject name="q" autocomplete="off" autocorrect="off" required maxlength="200" placeholder="Search term" i18n:attributes="placeholder">
                            <button class="btn btn-primary" type="submit">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                        <div class="typeahead">
                            <div class="cell small-12" data-typeahead-container>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <a class="visually-hidden-focusable" href="#content" i18n:translate>Skip navigation</a>
    <main class="flex-grow-1">
        <header id="header" tal:define="header_options request.app.org.header_options or {}">
            <nav tal:condition="request.is_logged_in or request.authenticated_email" id="globals" class="globals bg-dark-subtle navbar navbar-expand-lg p-0" tal:define="toolbox global_tools|False; modules modules|False">
                <div class="container">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarGlobals" aria-controls="navbarGlobals" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="navbarGlobals" class="collapse navbar-collapse justify-content-between">
                        <tal:b metal:use-macro="layout.macros['globals-left']"></tal:b>
                        <ul tal:condition="toolbox" class="navbar-nav global-tools-menu">
                            <li class="nav-item dropdown" tal:repeat="tool toolbox">
                                <tal:b condition="tool.links|nothing" define="dropdown_id 'global-dropdown-{}'.format(repeat.tool.number)">
                                <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" class="nav-link dropdown-toggle ${' '.join(tool.classes or '')}" tal:attributes="data-count tool.attributes['data-count']|nothing">${tool.title}</a>
                                <ul id="${dropdown_id}" class="dropdown-menu">
                                    <li tal:repeat="link tool.links">
                                        <tal:b replace="link(layout, ('nav-link', ))" />
                                    </li>
                                </ul>
                                </tal:b>
                                <tal:b condition="tool.url|tool.id|nothing" define="link tool">
                                    <tal:b replace="link(layout, ('nav-link', ))" />
                                </tal:b>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div tal:condition="header_options.get('announcement', '') and (request.is_logged_in or not header_options.get('announcement_is_private'))"
            id="header_announcement"
            style="background-color: ${header_options.get('announcement_bg_color', '#FBBC05')};">
                <div class="container" tal:define="url header_options.get('announcement_url');">
                        <a tal:condition="url" style="color: ${header_options.get('announcement_font_color', '#000000')}" href="${url}">
                            ${header_options['announcement']}</a>
                        <span tal:condition="not url" style="color: ${header_options.get('announcement_font_color', '#000000')}">${header_options['announcement']}</span>
                </div>
            </div>

            <tal:b tal:condition="not header_options.get('header_additions_fixed')">
                <tal:b metal:use-macro="layout.macros['header_links']"></tal:b>
                <tal:b metal:use-macro="layout.macros['header-text']"></tal:b>
            </tal:b>
            <div class="" data-sticky data-options="marginTop:0; stickyOn: small;" data-top-anchor="sticky-header-area:bottom" data-stick-to="top">

                <tal:b tal:condition="header_options.get('header_additions_fixed')">
                    <tal:b metal:use-macro="layout.macros['header_links']"></tal:b>
                    <tal:b metal:use-macro="layout.macros['header-text']"></tal:b>
                </tal:b>

                <div class="navigation-header">
                    <div class="bg-white">
                        <div class="container-fluid">
                            <ul class="nav justify-content-end py-1">
                                <li class="nav-item">
                                    <a class="nav-link link-secondary small px-2" href="#">Metanavigation</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link link-secondary small px-2" href="#">Metanavigation</a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <nav class="main-menu navbar navbar-light bg-white py-3">
                        <div class="container-fluid align-items-end">

                            <a class="navbar-brand" href="${layout.homepage_url}" tal:define="logo_url layout.org.logo_url|nothing" aria-label="Back to the homepage" i18n:attributes="aria-label">
                                <img tal:condition="logo_url" height="100" src="${layout.org.logo_url}" alt="Logo" title="${layout.org.title}" i18n:attributes="alt"/>
                                <div tal:condition="not:logo_url" metal:use-macro="layout.svg['default_logo']"></div>
                            </a>

                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#mainNav" aria-controls="mainNav"
                                    aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                            </button>

                            <div id="mainNav" class="collapse navbar-collapse">

                                <tal:b metal:use-macro="layout.macros['main_navigation']"></tal:b>

                                <div class="d-flex align-items-center gap-3">
                                    <a href="#" class="" data-bs-toggle="modal" data-bs-target="#searchModal">
                                        <i class="fa fa-search"></i>
                                    </a>
                                    <a href="#" class="btn btn-primary">
                                    Online-Schalter
                                    </a>
                                </div>

                            </div>
                        </div>
                    </nav>
                </div>

                <div metal:use-macro="layout.macros['editbar']"></div>
            </div>
        </header>

        <div class="container" id="alert-boxes">
            <div tal:condition="form.errors|nothing" class="alert alert-warning alert-dismissible fade show mt-md" role="alert">
                <tal:b i18n:translate>The form contains errors. Please check the fields marked in red.</tal:b>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <tal:b metal:use-macro="layout.macros['consume_messages']" />
        </div>

        <tal:b tal:define="on_homepage layout.on_homepage; sidebar_links layout.sidebar_links">

            <div tal:condition="on_homepage" class="content without-sidebar-links">
                <div role="main" id="content" data-reinit-foundation>
                    <div metal:define-slot="content"></div>
                </div>
            </div>

            <div tal:condition="not on_homepage and layout.org.theme_options.get('page-image-position', False) == 'header'" class="header-image">
                <div class="dark-overlay"></div>
                <div metal:define-slot="header-image"></div>
                <div class="grid-container">
                    <div class="grid-x grid-padding-x">
                        <div class="cell small-12">
                            <div class="text"><tal:b metal:define-slot="hi-title"></tal:b></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container">
                <div tal:condition="not: layout.on_homepage" metal:use-macro="layout.macros['breadcrumbs']"></div>
            </div>

            <div tal:condition="not: on_homepage" class="content my-5xl">
                <div id="intro" class="container mb-3xl">
                    <div class="row">
                        <div class="col-12 col-md-4 col-lg-3">
                            <h1 class="main-title fs-xs fw-bold text-primary">
                                <tal:b metal:define-slot="title"></tal:b>
                            </h1>
                        </div>
                        <div class="col-12 col-md-8 col-lg-9">
                            <p class="lead-text h1 text-primary mb-0">
                                <div metal:define-slot="lead"></div>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="container" role="main" id="content" data-reinit-foundation>
                    <div metal:define-slot="before-content"></div>
                    <div metal:define-slot="content"></div>
                </div>
            </div>
        </tal:b>

        <div tal:condition="layout.show_partners" id="partners-everywhere" class="partners-everywhere">
            <div class="grid-container full gray">
                <div class="grid-x">
                    <div class="cell small-12">
                        <div class="grid-container">
                            <div class="grid-x grid-padding-x grid-padding-y">
                                <div class="cell small-12">
                                    <metal:block use-macro="layout.macros['partner-cards']" tal:define="partners layout.partners; subpage layout.show_partners"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <metal:footer use-macro="layout.macros['footer']" />
    <div id="clipboard-copy" class="flash-message d-none" i18n:translate>Copied to Clipboard!</div>

</body>
</html>
