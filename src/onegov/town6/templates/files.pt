<!--? web components test -->
<template id="og-callout-template">
    <style>
        :host {
            display: block;
            border-radius: 4px;
            padding: 1rem;
            margin: 1rem 0;
            border-left: 4px solid var(--accent, #2196f3);
            background: color-mix(in srgb, var(--accent, #2196f3) 8%, transparent);
        }

        :host([type="alert"]) {
            --accent: #cc4b37;
        }

        :host([type="success"]) {
            --accent: #3adb76;
        }

        :host([type="warning"]) {
            --accent: #ffae00;
        }

        .title {
            font-weight: bold;
            margin-bottom: .25rem;
        }

        /* hide the title row entirely if no title was slotted */
        .title:not(:has(slot[name="title"]::slotted(*))) {
        }
    </style>

    <div class="title">
        <slot name="title"></slot>
    </div>   <!-- named slot -->
    <div class="body">
        <slot></slot>
    </div>                 <!-- default slot -->
</template>
<!--? end web components test -->

<div metal:use-macro="layout.base" i18n:domain="onegov.town6">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <!--? web components test -->
        <og-callout type="success">
            Well done, you made use of the new web component success message.
        </og-callout>

        <og-callout type="warning">
            <span slot="title">Warning</span>
            This action cannot be undone.
        </og-callout>

        <og-callout type="alert">
            <span slot="title">Error</span>
            Severe error happened while loading page!
        </og-callout>

        <og-callout>
            Type less callout
        </og-callout>
        <!--? end web components test -->

        <div class="grid-x">
            <div class="small-12 cell">
                <h2 i18n:translate="">Upload</h2>
                <tal:b metal:use-macro="layout.macros.upload">
                    <tal:b metal:fill-slot="upload-filelist">
                        <div class="upload-filelist-header" style="display: none;">
                            <h2 i18n:translate>Just Uploaded</h2>

                            <table class="files">
                                <tr>
                                    <th i18n:translate>
                                        Name
                                    </th>
                                    <th>
                                    </th>
                                    <th i18n:translate>
                                        Extension
                                    </th>
                                    <th i18n:translate>
                                        Upload Date
                                    </th>
                                    <th i18n:translate>
                                        Published until
                                    </th>
                                </tr>

                                <tbody class="upload-filelist"></tbody>
                            </table>
                        </div>
                    </tal:b>
                </tal:b>
            </div>
        </div>
        <div class="grid-x">
            <div class="small-12 cell">
                <h2 i18n:translate="">All Files</h2>

                <tal:b condition="not:count">
                    <p i18n:translate="">No files uploaded yet</p>
                </tal:b>

                <tal:b tal:condition="count">
                    <table class="files" tal:repeat="(group, files) grouped">
                        <thead>
                            <tr>
                                <th>
                                    <span tal:condition="model.order_by == 'name'">
                                        ${group}
                                    </span>
                                    <a
                                        tal:condition="model.order_by != 'name'"
                                        href="${request.link(model.for_order('name'))}"
                                        i18n:translate>

                                        Name
                                    </a>
                                </th>
                                <th>
                                </th>
                                <th i18n:translate>
                                    Extension
                                </th>
                                <th>
                                    <span tal:condition="model.order_by == 'date'">
                                        ${group}
                                    </span>
                                    <a tal:condition="model.order_by != 'date'"
                                       href="${request.link(model.for_order('date'))}"
                                       i18n:translate>Upload Date</a>
                                </th>
                                <th>
                                    <span tal:condition="model.order_by == 'publish_end_date'">
                                        ${group}
                                    </span>
                                    <a tal:condition="model.order_by != 'publish_end_date'"
                                       href="${request.link(model.for_order('publish_end_date'))}"
                                       i18n:translate>
                                       Published until
                                    </a>
                                </th>
                            </tr>
                        </thead>

                        <tbody tal:repeat="file files">
                            <tr style="height: 0;"></tr>
                            <tal:b metal:use-macro="layout.macros.file_info" />
                        </tbody>
                    </table>
                </tal:b>
            </div>
        </div>
    </tal:b>
</div>
