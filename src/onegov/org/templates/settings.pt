<div metal:use-macro="layout.base" i18n:domain="onegov.org">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">

            <div class="settings-search">
                <label for="settings-search" class="show-for-sr"
                       i18n:translate="">Search</label>
                <input id="settings-search" data-settings-search=""
                       type="search" placeholder="Search"
                       i18n:attributes="placeholder" autocomplete="off" />
            </div>

            <p data-settings-no-results="" hidden="hidden"
               aria-live="polite" i18n:translate="">No entries found.</p>

            <div tal:repeat="item settings_by_category"
                 class="settings-category">
                <h3 tal:content="item[0]" />
                <ul class="org-settings">
                    <li tal:repeat="setting item[1]"
                        class="${setting.name} cell" data-settings-item="">
                        <a href="${setting.link}">
                            <i class="fa ${setting.icon}"
                               aria-hidden="true"></i>
                            <span data-settings-title="">
                                ${setting.title}
                            </span>
                        </a>
                        <ul class="settings-search-results"
                            data-settings-fields="" hidden="hidden">
                            <li tal:repeat="field setting.fields"
                                data-settings-field="" hidden="hidden">
                                <a href="${field.link}">${field.title}</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

    </tal:b>
</div>
