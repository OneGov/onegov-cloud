<div metal:use-macro="layout.base" i18n:domain="onegov.org">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="content">
        <div class="audit-entry">
            <div class="audit-entry-summary">
                <span class="audit-operation audit-${entry.operation}">
                    ${operation}
                </span>
                <div class="audit-entry-heading">
                    <strong>
                        ${entry.snapshot.get('title', entry.target_table)}
                    </strong>
                    <small>
                        <i class="far fa-clock" aria-hidden="true"></i>
                        ${layout.format_date(entry.created, 'datetime')}
                    </small>
                </div>
            </div>

            <dl class="audit-entry-meta">
                <div>
                    <dt i18n:translate>When</dt>
                    <dd>
                        ${layout.format_date(entry.created, 'datetime')}
                    </dd>
                </div>
                <div>
                    <dt i18n:translate>Action</dt>
                    <dd>${operation}</dd>
                </div>
                <div>
                    <dt i18n:translate>Who</dt>
                    <dd>${entry.username}</dd>
                </div>
                <div>
                    <dt i18n:translate>Target table</dt>
                    <dd><code>${entry.target_table}</code></dd>
                </div>
                <div>
                    <dt i18n:translate>Target ID</dt>
                    <dd><code>${entry.target_id}</code></dd>
                </div>
                <div tal:condition="current_page">
                    <dt i18n:translate>Current page</dt>
                    <dd>
                        <a href="${request.link(current_page)}">
                            ${current_page.title}
                            <i class="fa fa-external-link-alt"
                               aria-hidden="true"></i>
                        </a>
                    </dd>
                </div>
            </dl>

            <section class="audit-snapshot-panel"
                     tal:condition="previous_snapshot">
                <h2 i18n:translate>Before update</h2>
                <pre class="audit-snapshot">${previous_snapshot}</pre>
            </section>

            <section class="audit-snapshot-panel">
                <h2 tal:condition="previous_snapshot"
                    i18n:translate>After update</h2>
                <h2 tal:condition="not:previous_snapshot"
                    i18n:translate>JSON Snapshot</h2>
                <pre class="audit-snapshot">${snapshot}</pre>
            </section>
        </div>
    </tal:b>
</div>
