<div metal:use-macro="layout.base" i18n:domain="onegov.org">
    <tal:b metal:fill-slot="title">
        ${title}
    </tal:b>
    <tal:b metal:fill-slot="body">
        <p i18n:translate>Hello!</p>
        <p i18n:translate>
            This is a friendly reminder for your upcoming reservation.
        </p>

        <p>
            <b><a href="${resource_url}">${resource.title}</a></b>
        </p>

        <tal:b define="start reservation.display_start(); end reservation.display_end(); quota reservation.quota; accepted True; show_status False">
            <p><metal:b use-macro="layout.macros['reservation']" /></p>
        </tal:b>

        <tal:b condition="form">
            <hr class="large">
            <p><b i18n:translate>Reservation confirmation</b></p>
            <metal:b use-macro="layout.macros['display_form']" />
        </tal:b>
    </tal:b>
    <tal:b metal:fill-slot="above-footer">
        <p>
            <span i18n:translate>
                This is a reservation reminder for <tal:b i18n:name="organisation">${organisation}</tal:b>.
            </span>
        </p>
    </tal:b>
</div>
